rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Gallery: public read; uploads only via the Firebase console / owners.
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
